import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:libri_flow/core/design_system/tokens/ds_colors.dart';
import 'package:libri_flow/core/design_system/tokens/ds_radius.dart';
import 'package:libri_flow/core/widgets/login_required_dialog.dart';
import 'package:libri_flow/core/services/api_service.dart';
import 'package:libri_flow/core/di/service_locator.dart';
import 'package:libri_flow/core/network/api_client.dart';

void main() {
  setUpAll(() {
    if (!sl.isRegistered<ApiClient>()) {
      sl.registerLazySingleton<ApiClient>(() => ApiClient(baseUrl: 'http://127.0.0.1:8899'));
    }
  });

  group('Phase 18.6 — Design Tokens & Standardization Invariants', () {
    test('Canonical color tokens are strictly defined', () {
      expect(DSColors.deepForestGreen, const Color(0xFF183D32));
      expect(DSColors.secondaryGreen, const Color(0xFF285C49));
      expect(DSColors.warmIvory, const Color(0xFFF8F5EE));
      expect(DSColors.surface, const Color(0xFFFFFDF8));
      expect(DSColors.charcoal, const Color(0xFF252923));
      expect(DSColors.softBorder, const Color(0xFFE7E1D6));
    });

    test('Canonical radius tokens match the design system scale', () {
      expect(DSRadius.xs, 4.0);
      expect(DSRadius.sm, 8.0);
      expect(DSRadius.md, 12.0);
      expect(DSRadius.card, 20.0);
      expect(DSRadius.xl, 28.0);
      expect(DSRadius.pill, 9999.0);
    });
  });

  group('Phase 18.6 — Accessibility & Touch Target Tests', () {
    testWidgets('LoginRequiredDialog renders with >= 48px action buttons and standardized radius', (WidgetTester tester) async {
      await tester.binding.setSurfaceSize(const Size(1024, 800));
      addTearDown(() => tester.binding.setSurfaceSize(null));

      await tester.pumpWidget(
        MaterialApp(
          theme: ThemeData(useMaterial3: true),
          home: const Scaffold(
            body: LoginRequiredDialog(),
          ),
        ),
      );
      await tester.pump();

      // Find ElevatedButton (Sign In)
      final elevated = find.byType(ElevatedButton);
      expect(elevated, findsOneWidget);

      final elevatedSize = tester.getSize(elevated);
      expect(elevatedSize.height, greaterThanOrEqualTo(48.0));

      // Find Create Account button
      final createAccountBtn = find.widgetWithText(OutlinedButton, 'Create Account');
      expect(createAccountBtn, findsOneWidget);

      final outlinedSize = tester.getSize(createAccountBtn);
      expect(outlinedSize.height, greaterThanOrEqualTo(48.0));
    });

    testWidgets('Tooltips are provided for accessible screen-reader navigation', (WidgetTester tester) async {
      await tester.pumpWidget(
        MaterialApp(
          theme: ThemeData(useMaterial3: true),
          home: Scaffold(
            body: Center(
              child: IconButton(
                tooltip: 'Back to Login',
                icon: const Icon(Icons.arrow_back),
                onPressed: () {},
              ),
            ),
          ),
        ),
      );
      await tester.pump();

      final tooltipFinder = find.byWidgetPredicate(
        (widget) => widget is Tooltip && widget.message == 'Back to Login',
      );
      expect(tooltipFinder, findsOneWidget);
    });
  });

  group('Phase 18.6 — Responsive Viewport Adaptation Tests', () {
    testWidgets('Layout renders cleanly across small mobile (360x800)', (WidgetTester tester) async {
      await tester.binding.setSurfaceSize(const Size(360, 800));
      addTearDown(() => tester.binding.setSurfaceSize(null));

      await tester.pumpWidget(
        MaterialApp(
          home: Scaffold(
            body: Center(
              child: Container(
                constraints: const BoxConstraints(maxWidth: 400),
                child: const LoginRequiredDialog(),
              ),
            ),
          ),
        ),
      );
      await tester.pump();
      expect(tester.takeException(), isNull);
    });

    testWidgets('Layout renders cleanly across tablet (768x1024)', (WidgetTester tester) async {
      await tester.binding.setSurfaceSize(const Size(768, 1024));
      addTearDown(() => tester.binding.setSurfaceSize(null));

      await tester.pumpWidget(
        MaterialApp(
          home: Scaffold(
            body: Center(
              child: Container(
                constraints: const BoxConstraints(maxWidth: 600),
                child: const LoginRequiredDialog(),
              ),
            ),
          ),
        ),
      );
      await tester.pump();
      expect(tester.takeException(), isNull);
    });

    testWidgets('Layout renders cleanly across desktop (1440x900)', (WidgetTester tester) async {
      await tester.binding.setSurfaceSize(const Size(1440, 900));
      addTearDown(() => tester.binding.setSurfaceSize(null));

      await tester.pumpWidget(
        MaterialApp(
          home: Scaffold(
            body: Center(
              child: Container(
                constraints: const BoxConstraints(maxWidth: 1200),
                child: const LoginRequiredDialog(),
              ),
            ),
          ),
        ),
      );
      await tester.pump();
      expect(tester.takeException(), isNull);
    });
  });

  group('Phase 18.6 — Persona Separation & Security Invariants', () {
    test('Student and Reader personas maintain strict role segregation', () {
      ApiService.activeExperience = UserType.student;
      expect(ApiService.activeExperience, UserType.student);
      expect(ApiService.activeExperience == UserType.reader, isFalse);

      ApiService.activeExperience = UserType.reader;
      expect(ApiService.activeExperience, UserType.reader);
      expect(ApiService.activeExperience == UserType.student, isFalse);
    });

    test('Provider capability is disabled by default for un-activated users', () {
      ApiService.providerEnabled = false;
      expect(ApiService.providerEnabled, isFalse);

      ApiService.providerEnabled = true;
      expect(ApiService.providerEnabled, isTrue);
      // Reset
      ApiService.providerEnabled = false;
    });

    test('Admin authorization prevents ordinary user escalation', () {
      ApiService.token = 'mock_jwt_token';
      ApiService.isAdmin = false;

      // Gate: Must be both logged in and admin
      final isAuthorizedAdmin = ApiService.isLoggedIn && ApiService.isAdmin;
      expect(isAuthorizedAdmin, isFalse);

      ApiService.isAdmin = true;
      final authorizedAdmin = ApiService.isLoggedIn && ApiService.isAdmin;
      expect(authorizedAdmin, isTrue);

      // Reset
      ApiService.isAdmin = false;
      ApiService.token = null;
    });
  });
}
