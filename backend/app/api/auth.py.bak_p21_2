# ✅ Forgot Password Form Submit (POST) - For HTML form
@router.post("/auth/forgot-password-form")
@limiter.limit("5/minute")
def forgot_password_form(request: Request, email: str = Form(...), db: Session = Depends(get_db)):
    from sqlalchemy import func
    from app.models.password_reset import PasswordReset
    import hashlib
    import logging

    logger = logging.getLogger("app.api.auth")
    ident = email.strip()
    user = db.query(User).filter(
        (func.lower(User.email) == ident.lower()) |
        (User.phone == ident)
    ).first()
    if user:
        # Invalidate previous unused reset tokens for this user
        db.query(PasswordReset).filter(
            PasswordReset.user_id == user.id,
            PasswordReset.used == False
        ).update({"used": True})

        raw_token = create_reset_token(user.email)
        token_hash = hashlib.sha256(raw_token.encode("utf-8")).hexdigest()
        
        # Save SHA-256 hashed token to database (15-min expiry, single-use)
        reset_entry = PasswordReset(
            user_id=user.id,
            token=token_hash,
            expires_at=datetime.datetime.utcnow() + datetime.timedelta(minutes=15)
        )
        db.add(reset_entry)
        db.commit()
        
        reset_link = generate_reset_link(request, raw_token)
        success, err = send_reset_password_email(user.email, reset_link)
        if not success:
            logger.error(f"[AUTH] Failed to dispatch password reset email to {mask_email(user.email)}: {err}")
    else:
        logger.warning(f"Forgot password requested for non-existent account: {mask_email(email)}")

    html = render_template("message.html", title="Reset Link Sent", heading="Check Your Email", message="If an account exists with that email, a password reset link has been sent. It will expire in 15 minutes.", is_success=True)
    return HTMLResponse(content=html)

# ✅ Forgot Password endpoint (API JSON)
@router.post("/auth/forgot-password")
@router.post("/forgot-password")
@limiter.limit("5/minute")
async def forgot_password(request: Request, db: Session = Depends(get_db)):
    from sqlalchemy import func
    from app.models.password_reset import PasswordReset
    import os
    import hashlib
    import logging

    logger = logging.getLogger("app.api.auth")
    data = await request.json()
    email = data.get("email")
    if not email:
        raise HTTPException(status_code=400, detail="Email is required")
        
    ident = email.strip()
    user = db.query(User).filter(
        (func.lower(User.email) == ident.lower()) |
        (User.phone == ident)
    ).first()
    if user:
        # Invalidate previous unused reset tokens for this user
        db.query(PasswordReset).filter(
            PasswordReset.user_id == user.id,
            PasswordReset.used == False
        ).update({"used": True})

        raw_token = create_reset_token(user.email)
        token_hash = hashlib.sha256(raw_token.encode("utf-8")).hexdigest()
        
        # Save SHA-256 hashed token to database (15-minute expiry, single use)
        reset_entry = PasswordReset(
            user_id=user.id,
            token=token_hash,
            expires_at=datetime.datetime.utcnow() + datetime.timedelta(minutes=15)
        )
        db.add(reset_entry)
        db.commit()
        
        reset_link = generate_reset_link(request, raw_token)
        masked = mask_email(user.email)
        logger.info(f"Password reset requested for {masked}.")
        
        # Dispatch email to the user's specific email address
        success, err = send_reset_password_email(user.email, reset_link)
        if not success:
            logger.error(f"Failed to dispatch password reset email to {masked}: {err}")
            if "EXTERNAL CONFIGURATION REQUIRED" in err:
                raise HTTPException(status_code=502, detail=err)
    else:
        masked = mask_email(email)
        logger.warning(f"Forgot password requested for non-existent account: {masked}")

    return {"message": "If an account exists, a password reset link has been sent."}

# ✅ Reset Password Page (GET)
@router.get("/reset-password")
def get_reset_password_page(request: Request, token: str, db: Session = Depends(get_db)):
    from app.models.password_reset import PasswordReset
    import datetime
    import hashlib
    import os
    
    token_hash = hashlib.sha256(token.encode("utf-8")).hexdigest()
    reset_entry = db.query(PasswordReset).filter((PasswordReset.token == token_hash) | (PasswordReset.token == token)).first()
    
    if not reset_entry or reset_entry.used or reset_entry.expires_at < datetime.datetime.utcnow():
        html = render_template("message.html", title="Invalid Link", heading="Link Expired", message="This password reset link is invalid or has expired. Please request a new one.", is_success=False)
        return HTMLResponse(content=html, status_code=400)

    frontend_url = get_frontend_url(request)
    if frontend_url:
        return RedirectResponse(url=f"{frontend_url}/#/reset-password?token={token}")

    login_url = f"{frontend_url}/#/login" if frontend_url else "/"
    html = render_template("reset_password.html", token=token, login_url=login_url)
    return HTMLResponse(content=html)


