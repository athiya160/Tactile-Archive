        "play_store_assets/metadata/account_deletion.html",
        "frontend/web/account_deletion.html",
    ]
    for p in candidates:
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    return f.read()
            except Exception:
                pass
    return """<!DOCTYPE html>
<html lang="en">
