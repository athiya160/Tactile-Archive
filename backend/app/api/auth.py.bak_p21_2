# ✅ Reset Password Action (POST) - Supports HTML Form and JSON API
@router.post("/reset-password")
@router.post("/auth/reset-password")
@limiter.limit("10/minute")
async def post_reset_password(request: Request, background_tasks: BackgroundTasks, db: Session = Depends(get_db)):
    from app.models.password_reset import PasswordReset
    from app.core.mail import send_password_changed_email
    import re
    import datetime
    import hashlib
    
    is_form = False
    content_type = request.headers.get("content-type", "")
    if "application/x-www-form-urlencoded" in content_type or "multipart/form-data" in content_type:
        is_form = True
        form = await request.form()
        token = form.get("token")
        new_password = form.get("new_password")
    else:
        try:
            data = await request.json()
            token = data.get("token")
            new_password = data.get("new_password")
        except Exception:
            token = None
            new_password = None

    def _error_response(msg: str, status_code: int = 400):
        if is_form:
            html = render_template("message.html", title="Reset Password Failed", heading="Error", message=msg, is_success=False)
            return HTMLResponse(content=html, status_code=status_code)
        raise HTTPException(status_code=status_code, detail=msg)

    if not token or not new_password:
        return _error_response("Token and new password are required.")

    # Find the token in the DB by SHA-256 hash (or legacy plain match)
    token_hash = hashlib.sha256(token.encode("utf-8")).hexdigest()
    reset_entry = db.query(PasswordReset).filter((PasswordReset.token == token_hash) | (PasswordReset.token == token)).first()
    
    if not reset_entry:
        return _error_response("Invalid reset token.")
        
    if reset_entry.used:
        return _error_response("This reset token has already been used.")
        
    if reset_entry.expires_at < datetime.datetime.utcnow():
        return _error_response("This reset token has expired.")
        
    # Validate password complexity
    if len(new_password) < 8 or not re.search(r"[A-Z]", new_password) or not re.search(r"[a-z]", new_password) or not re.search(r"\d", new_password) or not re.search(r"[\W_]", new_password):
        return _error_response("Password must be at least 8 characters long and contain uppercase, lowercase, number, and special character.")

    user = db.query(User).filter(User.id == reset_entry.user_id).first()
    if not user:
        return _error_response("User not found.", status_code=404)
        
    if verify_password(new_password, user.password):
        return _error_response("New password cannot be the same as your old password.")

    user.password = hash_password(new_password)
    user.token_version = (getattr(user, "token_version", 1) or 1) + 1
    reset_entry.used = True
    db.commit()
    
    background_tasks.add_task(send_password_changed_email, user.email)
    
    if is_form:
        html = render_template("message.html", title="Password Reset Successful", heading="Success!", message="Your password has been updated successfully. You can now log in with your new password.", is_success=True)
        return HTMLResponse(content=html)

    return {"message": "Your password has been updated successfully."}

# ✅ Send 6-Digit OTP (API JSON)
@router.post("/auth/send-otp")
@limiter.limit("5/minute")
async def send_otp(request: Request, background_tasks: BackgroundTasks, db: Session = Depends(get_db)):
    from app.models.otp_code import OTPCode
    from app.core.mail import send_otp_email
    from app.core.sms import send_otp_sms
    from app.core.otp import generate_secure_otp, clear_failed_attempts

    data = await request.json()
    identifier = data.get("identifier") or data.get("email") or data.get("phone")
    purpose = data.get("purpose", "password_reset")

    if not identifier:
        raise HTTPException(status_code=400, detail="Email or Phone Number is required")

    identifier = identifier.strip().lower()

    # Generate cryptographically secure 6-digit OTP code using CSPRNG
    otp_str = generate_secure_otp()

    # Invalidate previous unused OTPs for this identifier & purpose
    db.query(OTPCode).filter(
        OTPCode.identifier == identifier,
        OTPCode.purpose == purpose,
        OTPCode.used == False
    ).update({"used": True})

    otp_entry = OTPCode(
        identifier=identifier,
        code=otp_str,
        purpose=purpose,
        expires_at=datetime.datetime.utcnow() + datetime.timedelta(minutes=10)
    )
    db.add(otp_entry)
    db.commit()

    # Reset attempt tracker when fresh OTP requested
    clear_failed_attempts(identifier, purpose)

    action_name = "Password Reset" if purpose == "password_reset" else "OTP Login"

    if "@" in identifier:
        background_tasks.add_task(send_otp_email, identifier, otp_str, action_name)
    else:
        background_tasks.add_task(send_otp_sms, identifier, otp_str, action_name)

    return {"message": f"6-digit OTP code sent successfully for {action_name}."}

# ✅ Reset Password with 6-Digit OTP (API JSON)
@router.post("/auth/verify-otp-reset")
@limiter.limit("5/minute")
async def verify_otp_reset(request: Request, background_tasks: BackgroundTasks, db: Session = Depends(get_db)):
    from app.models.otp_code import OTPCode
    from app.core.otp import validate_and_verify_otp
    from sqlalchemy import func
    import re

    data = await request.json()
    identifier = data.get("identifier") or data.get("email")
    otp_code = data.get("otp_code") or data.get("code")
    new_password = data.get("new_password")

    if not identifier or not otp_code or not new_password:
        raise HTTPException(status_code=400, detail="Identifier, OTP code, and new password are required.")

    identifier = identifier.strip().lower()

    # Validates attempt counter, expiry, constant-time compare, and single-use
    otp_entry = validate_and_verify_otp(
        db=db,
        otp_model=OTPCode,
        identifier=identifier,
        purpose="password_reset",
        submitted_code=otp_code,
        mark_used=False
    )

    # Validate password complexity
    if len(new_password) < 8 or not re.search(r"[A-Z]", new_password) or not re.search(r"[a-z]", new_password) or not re.search(r"\d", new_password) or not re.search(r"[\W_]", new_password):
        raise HTTPException(status_code=400, detail="Password must be at least 8 characters long and contain uppercase, lowercase, number, and special character.")

    user = db.query(User).filter(
        (func.lower(User.email) == identifier.strip().lower()) |
        (User.phone == identifier.strip())
    ).first()
    if not user:
        raise HTTPException(status_code=404, detail="User account not found.")

    if verify_password(new_password, user.password):
        raise HTTPException(status_code=400, detail="New password cannot be the same as your old password.")

    user.password = hash_password(new_password)
    user.token_version = (getattr(user, "token_version", 1) or 1) + 1
    if otp_entry:
        otp_entry.used = True
    db.commit()

    background_tasks.add_task(send_password_changed_email, user.email)
    return {"message": "Your password has been reset successfully using OTP."}

# ✅ Login with 6-Digit OTP (API JSON)
@router.post("/auth/login-otp")
@limiter.limit("10/minute")
async def login_with_otp(request: Request, background_tasks: BackgroundTasks, db: Session = Depends(get_db)):
    from app.models.otp_code import OTPCode
    from app.core.otp import validate_and_verify_otp
    from sqlalchemy import func
    import secrets

    data = await request.json()
    identifier = data.get("identifier") or data.get("email") or data.get("phone")
    otp_code = data.get("otp_code") or data.get("code")

    if not identifier or not otp_code:
        raise HTTPException(status_code=400, detail="Identifier and OTP code are required.")

    identifier = identifier.strip().lower()

    # Validates attempt counter, expiry, constant-time compare, and marks used upon success
    otp_entry = validate_and_verify_otp(
        db=db,
        otp_model=OTPCode,
        identifier=identifier,
        purpose="login_otp",
        submitted_code=otp_code,
        mark_used=True
    )

    user = db.query(User).filter(func.lower(User.email) == identifier).first()
    if not user:
        # Auto-create user if logging in via phone/email OTP for the first time
        name = identifier.split("@")[0] if "@" in identifier else f"User_{identifier[-4:]}"
        user = User(
            email=identifier if "@" in identifier else f"{identifier}@mobile.user",
            phone=identifier if not "@" in identifier else None,
            password=hash_password(secrets.token_urlsafe(16)),
            name=name,
            is_verified=True,
            role="customer",
            user_type="reader"
        )
        db.add(user)
        db.commit()
        db.refresh(user)

    user_persona = getattr(user, "user_type", "reader") or "reader"
    user_ver = getattr(user, "token_version", 1) or 1
    new_refresh_jti = uuid.uuid4().hex
    access_token = create_access_token(
        {"sub": user.email, "role": user.role, "user_type": user_persona, "persona": user_persona},
        refresh_jti=new_refresh_jti,
        token_version=user_ver
    )
    refresh_token = create_refresh_token(
        {"sub": user.email, "role": user.role},
        jti=new_refresh_jti,
        token_version=user_ver
    )
    return {
        "access_token": access_token,
        "token_type": "bearer",
        "refresh_token": refresh_token,
        "role": user.role,
        "user_type": user_persona,
        "persona": user_persona,
        "name": user.name or user.email,
        "onboarding_completed": user.onboarding_completed
    }

