            margin-bottom: 16px;
        }
        label {
            display: block;
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 6px;
            color: var(--primary);
        }
        input[type="email"], textarea {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 14px;
            box-sizing: border-box;
        }
        button {
            background-color: var(--danger);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 15px;
            cursor: pointer;
            transition: background 0.2s;
        }
        button:hover {
            background-color: #B91C1C;
        }
        .status-msg {
            display: none;
            padding: 12px;
            border-radius: 8px;
            margin-top: 16px;
            font-size: 14px;
        }
        .footer {
            margin-top: 32px;
            padding-top: 16px;
            border-top: 1px solid var(--border);
            font-size: 13px;
            color: var(--text-muted);
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>The Tactile Archive / LibriFlow</h1>
        <div class="subtitle">Account Deletion & Data Erasure Portal (Google Play Policy Compliance)</div>

        <div class="danger-card">
            <div class="danger-title">Important Account Deletion Notice</div>
            <p style="margin: 0; font-size: 14px;">
                Requesting account deletion will permanently close your account and remove your personal identification from The Tactile Archive and LibriFlow apps and services.
            </p>
        </div>

        <div class="section-title">1. How to Delete In-App (Instant)</div>
        <p>The fastest way to delete your account is directly within the mobile application:</p>
        <ol>
            <li>Open the <strong>LibriFlow</strong> app on your device.</li>
            <li>Navigate to <strong>Profile</strong> &rarr; <strong>Account Settings</strong>.</li>
            <li>Scroll to the <strong>Danger Zone</strong> section at the bottom.</li>
            <li>Tap <strong>Delete Account</strong>, enter your password or confirmation, and confirm deletion.</li>
        </ol>

        <div class="section-title">2. Data Deleted vs. Data Retained</div>
        <p>In accordance with GDPR, CCPA, and Google Play policies:</p>
        <ul>
            <li><strong>Data Permanently Deleted:</strong> Your name, phone number, shipping address, profile picture, reading logs, bookmarks, student schedule, goals, favorites, and cart contents are immediately and permanently erased.</li>
            <li><strong>Data Retained:</strong> Historical financial transaction logs (completed order items and payments) are retained in fully anonymized form as required by statutory financial, taxation, and anti-fraud laws.</li>
        </ul>

        <div class="section-title">3. Request Deletion via Web</div>
        <p>If you have uninstalled the app or cannot sign in, submit your registered account email below. Our team will verify and execute your account deletion within 30 days.</p>

        <form id="deletion-form">
            <div class="form-group">
                <label for="email">Account Email Address:</label>
                <input type="email" id="email" name="email" required placeholder="user@example.com">
            </div>
            <div class="form-group">
                <label for="reason">Reason for Deletion (Optional):</label>
                <textarea id="reason" name="reason" rows="3" placeholder="Tell us why you are deleting your account..."></textarea>
            </div>
            <button type="submit" id="submit-btn">Submit Account Deletion Request</button>
            <div id="status-msg" class="status-msg"></div>
        </form>

        <script>
            document.getElementById('deletion-form').addEventListener('submit', async function(e) {
                e.preventDefault();
                const btn = document.getElementById('submit-btn');
                const status = document.getElementById('status-msg');
                const email = document.getElementById('email').value;
                const reason = document.getElementById('reason').value;

                btn.disabled = true;
                btn.innerText = 'Submitting...';

                try {
                    const response = await fetch('/auth/request-account-deletion', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email: email, reason: reason })
                    });
                    const data = await response.json();
                    status.style.display = 'block';
                    status.style.backgroundColor = '#ECFDF5';
                    status.style.color = '#065F46';
                    status.style.border = '1px solid #A7F3D0';
                    status.innerText = data.message || 'Account deletion request submitted successfully.';
                    document.getElementById('deletion-form').reset();
                } catch (err) {
                    status.style.display = 'block';
                    status.style.backgroundColor = '#FEF2F2';
                    status.style.color = '#991B1B';
                    status.style.border = '1px solid #FECACA';
                    status.innerText = 'An error occurred while submitting your request. Please email support@tactilearchive.org.';
                } finally {
                    btn.disabled = false;
                    btn.innerText = 'Submit Account Deletion Request';
                }
            });
        </script>

        <div class="footer">
            Questions? Contact Privacy & Compliance: <strong>support@tactilearchive.org</strong> | +91 99864 74220<br>
            The Tactile Archive &copy; 2026. All rights reserved.
        </div>
    </div>
</body>
</html>"""


@router.delete("/users/me")
def delete_user_account(
    payload: Optional[AccountDeleteRequest] = None,
    credentials: HTTPAuthorizationCredentials = Depends(security),
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user)
):
    """
    Permanently delete or anonymize user account in compliance with Google Play Store data safety guidelines.
    - Requires password verification (for password-based accounts) or confirmation token (for OAuth/Google accounts).
    - Blocks deletion if active/unfulfilled orders, rentals, or borrow requests exist.
    - Purges personal profiles, cart, favorites, addresses, notifications, and personal metadata.
    - Preserves historical completed/cancelled order and payment records for statutory tax/financial compliance,
      while completely scrubbing all user PII (anonymization).
    - Hard-deletes users with zero financial/order transaction history.
    - Revokes current JWT session token immediately.
    """
    import uuid
    from app.models.order import Order, BorrowRequest, RentalOrder, PurchaseOrder
    from app.models.payment import Payment
    from app.models.address import Address
    from app.models.cart import Cart, CartItem
    from app.models.favorite import Favorite
    from app.models.notification import Notification, FCMToken
    from app.models.password_reset import PasswordReset
    from app.models.inventory_reservation import InventoryReservation
    from app.models.badge import UserBadge
    from app.models.review import Review
    from app.models.student_profile import StudentProfile
    from app.models.reader_profile import ReaderProfile
    from app.models.student_data import StudentSubject, StudentScheduleItem, StudentAssignment, StudentGoal
    from app.models.reader_data import BookshelfItem, ReadingGoal
    from app.models.subscription import NeighborhoodSubscription

    # 0. Repeat deletion guard
    if getattr(user, "role", None) == "deleted":
        raise HTTPException(
            status_code=400,
            detail="Account has already been deleted and personal data erased."
        )

    # 1. Re-authentication verification
    if user.password:
        if not payload or not payload.password or not verify_password(payload.password, user.password):
            raise HTTPException(
                status_code=400,
                detail="Invalid password. Re-authentication is required to delete your account."
            )
    else:
        # OAuth / Google passwordless user
        conf = (payload.confirmation if payload and payload.confirmation else "").strip().upper()
        if conf not in ["DELETE", "DELETE MY ACCOUNT", "DELETE_ACCOUNT"]:
            raise HTTPException(
                status_code=400,
                detail="Confirmation required. Please provide confirmation 'DELETE' to confirm account deletion."
            )

    # 2. Check for active/unfulfilled orders or rentals or borrows (as customer or provider/lender)
    active_order_statuses = ["pending", "processing", "confirmed", "dispatched", "in_transit"]
    active_orders = db.query(Order).filter(
        Order.user_id == user.id,
        (Order.status.in_(active_order_statuses) | Order.shipping_status.in_(active_order_statuses) | (Order.handoff_status == "pending_handoff"))
    ).count()

    active_rentals = db.query(RentalOrder).filter(
        (RentalOrder.user_id == user.id) | (RentalOrder.book.has(owner_id=user.id)),
        RentalOrder.status.in_(["active", "rented", "pending"])
    ).count()

    active_borrows = db.query(BorrowRequest).filter(
        (BorrowRequest.user_id == user.id) | (BorrowRequest.book.has(owner_id=user.id)),
        BorrowRequest.status.in_(["active", "approved", "borrowed", "pending"])
    ).count()

    active_provider_orders = db.query(OrderItem).filter(
        OrderItem.provider_id == user.id,
        OrderItem.order.has(Order.status.in_(active_order_statuses))
    ).count()

    if active_orders > 0 or active_rentals > 0 or active_borrows > 0 or active_provider_orders > 0:
        raise HTTPException(
            status_code=400,
            detail="Cannot delete account with active or unfulfilled orders, rentals, or borrow requests. Please complete, return, or cancel all active items first."
        )

    # 3. Purge ancillary personal data
    db.query(Address).filter(Address.user_id == user.id).delete(synchronize_session=False)

    user_cart = db.query(Cart).filter(Cart.user_id == user.id).first()
    if user_cart:
        db.query(CartItem).filter(CartItem.cart_id == user_cart.id).delete(synchronize_session=False)
        db.delete(user_cart)

    db.query(Favorite).filter(Favorite.user_id == user.id).delete(synchronize_session=False)
    db.query(Notification).filter(Notification.user_id == user.id).delete(synchronize_session=False)
    db.query(FCMToken).filter(FCMToken.user_id == user.id).delete(synchronize_session=False)
    db.query(PasswordReset).filter(PasswordReset.user_id == user.id).delete(synchronize_session=False)
    db.query(InventoryReservation).filter(InventoryReservation.user_id == user.id).delete(synchronize_session=False)
    db.query(UserBadge).filter(UserBadge.user_id == user.id).delete(synchronize_session=False)
    db.query(BookshelfItem).filter(BookshelfItem.user_id == user.id).delete(synchronize_session=False)
    db.query(ReadingGoal).filter(ReadingGoal.user_id == user.id).delete(synchronize_session=False)
    db.query(StudentSubject).filter(StudentSubject.user_id == user.id).delete(synchronize_session=False)
    db.query(StudentScheduleItem).filter(StudentScheduleItem.user_id == user.id).delete(synchronize_session=False)
    db.query(StudentAssignment).filter(StudentAssignment.user_id == user.id).delete(synchronize_session=False)
    db.query(StudentGoal).filter(StudentGoal.user_id == user.id).delete(synchronize_session=False)
    db.query(StudentProfile).filter(StudentProfile.user_id == user.id).delete(synchronize_session=False)
    db.query(ReaderProfile).filter(ReaderProfile.user_id == user.id).delete(synchronize_session=False)
    db.query(NeighborhoodSubscription).filter(NeighborhoodSubscription.user_id == user.id).delete(synchronize_session=False)

    # Provider book listings -> archive and delist
    user_books = db.query(Book).filter(Book.owner_id == user.id).all()
    for book in user_books:
        book.approval_status = "archived"
        book.stock = 0
        book.is_available = False

    # User reviews -> anonymize
    user_reviews = db.query(Review).filter(Review.user_id == user.id).all()
    for rev in user_reviews:
        rev.user_name = "Former Reader (Account Deleted)"

    # 4. Check historical financial or contractual transactions
    total_orders = db.query(Order).filter(Order.user_id == user.id).count()
    total_rentals = db.query(RentalOrder).filter(RentalOrder.user_id == user.id).count()
    total_purchases = db.query(PurchaseOrder).filter(PurchaseOrder.user_id == user.id).count()
    total_borrows = db.query(BorrowRequest).filter(BorrowRequest.user_id == user.id).count()
    total_payments = db.query(Payment).filter(Payment.user_id == user.id).count()

    has_financial_history = (total_orders > 0 or total_rentals > 0 or total_purchases > 0 or total_borrows > 0 or total_payments > 0)

    if has_financial_history:
        anon_suffix = uuid.uuid4().hex[:8]
        user.name = "[Deleted User]"
        user.email = f"deleted_{user.id}_{anon_suffix}@deleted.tactilearchive.org"
        user.password = hash_password(uuid.uuid4().hex)
        user.google_id = None
        user.phone = None
        user.address = None
        user.bio = None
        user.avatar_url = None
        user.role = "deleted"
        user.user_type = "deleted"
        user.active_experience = "deleted"
        user.provider_enabled = False
        user.provider_status = "deleted"
        user.notifications = None
        user.token_version = (getattr(user, "token_version", 1) or 1) + 1

        # Redact personal shipping info on past orders
        past_orders = db.query(Order).filter(Order.user_id == user.id).all()
        for ord_record in past_orders:
            ord_record.recipient_name = "[Deleted User]"
            ord_record.recipient_phone = None
            ord_record.delivery_address = "[Redacted - Account Deleted]"

        action_taken = "anonymized_and_scrubbed"
        retained = [
            "Order records (preserved for statutory tax & audit compliance)",
            "Payment transaction records (preserved for legal and anti-fraud compliance)"
        ]
    else:
        # Zero orders or transactions -> safe to hard-delete user entity
        db.delete(user)
        action_taken = "hard_deleted"
        retained = []

    db.commit()

    # Invalidate token immediately
    token = credentials.credentials
    REVOKED_TOKENS.add(token)
    try:
        del_payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])
        del_jti = del_payload.get("jti")
        del_rti = del_payload.get("rti")
        del_exp = del_payload.get("exp")
        del_expires = datetime.datetime.fromtimestamp(del_exp, tz=datetime.timezone.utc) if del_exp else None
        target_uid = user.id if action_taken != "hard_deleted" else 0
        if target_uid != 0:
            if del_jti:
                revoke_token_record(db, del_jti, "access", target_uid, expires_at=del_expires, reason="account_deletion", raw_token=token)
            if del_rti:
                revoke_token_record(db, del_rti, "refresh", target_uid, reason="account_deletion_rti")
            db.commit()
    except Exception as del_err:
        logger.warning(f"Error persisting token revocation during account deletion: {del_err}")

    logger.info(f"[PRIVACY COMPLIANCE] User ID {user.id} account deletion executed. Action: {action_taken}. Financial history preserved: {has_financial_history}.")

    return {
        "success": True,
        "message": "Account has been successfully deleted and personal data permanently erased.",
        "action_taken": action_taken,
        "retained_records": retained
    }


@router.get("/delete-account", response_class=HTMLResponse)
@router.get("/account-deletion-info", response_class=HTMLResponse)
def get_account_deletion_web_page():
    """
    Public web page resource for Google Play account deletion compliance.
    Accessible without requiring the mobile application.
    """
    return HTMLResponse(content=render_account_deletion_html(), status_code=200)


@router.post("/auth/request-account-deletion", response_model=PublicAccountDeletionResponse)
def request_account_deletion_external(
    payload: PublicAccountDeletionRequest,
    request: Request = None,
    db: Session = Depends(get_db)
):
    """
    Public web endpoint for external account deletion requests (Google Play Store compliance).
    Accepts an email address from users requesting their account and associated data be deleted.
    Persists requests transactionally to the dedicated account_deletion_requests table.
    """
    from sqlalchemy import func
    cleaned_email = (payload.email or "").strip().lower()
    if not cleaned_email or "@" not in cleaned_email:
        raise HTTPException(status_code=400, detail="A valid email address is required.")

    logger.info(f"[PRIVACY COMPLIANCE] External account deletion request received for masked email.")
    user = db.query(User).filter(func.lower(User.email) == cleaned_email).first()
    user_id = user.id if user else None

    # Check if user was already deleted prior to this request
    is_already_deleted = user is not None and getattr(user, "role", None) == "deleted"

    # Prevent duplicate active requests for the same email
    existing_req = db.query(AccountDeletionRequest).filter(
        AccountDeletionRequest.email == cleaned_email,
        AccountDeletionRequest.status.in_(["pending", "in_review"])
    ).order_by(AccountDeletionRequest.id.desc()).first()

    if existing_req:
        if payload.reason and not existing_req.reason:
            existing_req.reason = payload.reason.strip()
        existing_req.updated_at = datetime.datetime.utcnow()
        db.commit()
        db.refresh(existing_req)
        logger.info(f"[PRIVACY COMPLIANCE] Duplicate deletion request refreshed for request ID: {existing_req.request_id}")
        return {
            "success": True,
            "message": "Your account deletion request has already been received and is currently queued for review. If an account associated with this email exists, a confirmation and processing notification will be sent.",
            "request_id": existing_req.request_id,
            "status": existing_req.status,
            "is_duplicate": True
        }

    client_ip = get_trusted_client_ip(request) if request else None
    ip_hash = hashlib.sha256(client_ip.encode("utf-8")).hexdigest() if client_ip else None

    initial_status = "completed" if is_already_deleted else "pending"
    initial_notes = "Account was already deleted prior to external request." if is_already_deleted else None

    new_req = AccountDeletionRequest(
        user_id=user_id,
        email=cleaned_email,
        reason=payload.reason.strip() if payload.reason else None,
        status=initial_status,
        ip_hash=ip_hash,
        resolution_notes=initial_notes,
        processed_at=datetime.datetime.utcnow() if is_already_deleted else None
    )
    db.add(new_req)
    db.commit()
    db.refresh(new_req)
    logger.info(f"[PRIVACY COMPLIANCE] Account deletion request {new_req.request_id} successfully persisted.")

    return {
        "success": True,
        "message": "Your account deletion request has been received and queued for review. If an account associated with this email exists, a confirmation and processing notification will be sent.",
        "request_id": new_req.request_id,
        "status": new_req.status,
        "is_duplicate": False
    }


def render_privacy_policy_html() -> str:
    """
    Render the canonical Privacy Policy HTML for public web hosting and Google Play compliance.
    """
    import os
    candidates = [
        os.path.join(os.path.dirname(__file__), "../../../play_store_assets/metadata/privacy_policy.html"),
        os.path.join(os.path.dirname(__file__), "../../../frontend/web/privacy_policy.html"),
        os.path.join(os.path.dirname(__file__), "../static/privacy_policy.html"),
        "static/privacy_policy.html",
        "play_store_assets/metadata/privacy_policy.html",
        "frontend/web/privacy_policy.html",
    ]
    for p in candidates:
        if os.path.exists(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    return f.read()
            except Exception:
                pass
    return "<!DOCTYPE html><html><head><title>Privacy Policy - The Tactile Archive</title></head><body><h1>Privacy Policy</h1><p>The Tactile Archive / LibriFlow Privacy Policy.</p></body></html>"


@router.get("/privacy-policy", response_class=HTMLResponse)
@router.get("/privacy", response_class=HTMLResponse)
def get_privacy_policy_web_page():
    """
    Public web page resource for Google Play Privacy Policy compliance.
    Accessible without requiring the mobile application.
    """
    return HTMLResponse(content=render_privacy_policy_html(), status_code=200)
