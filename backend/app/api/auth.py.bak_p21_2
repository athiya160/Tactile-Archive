# ✅ Login (returns token)
@router.post("/login")
@limiter.limit("10/minute")
def login(request: Request, user_credentials: UserCreate, background_tasks: BackgroundTasks, db: Session = Depends(get_db)):
    from sqlalchemy import func
    ident = (user_credentials.email or "").strip()
    user = db.query(User).filter(
        (func.lower(User.email) == ident.lower()) |
        (User.phone == ident)
    ).first()

    if not user or not verify_password(user_credentials.password, user.password):
        raise HTTPException(status_code=400, detail="Invalid credentials")

    user_ver = getattr(user, "token_version", 1) or 1
    new_refresh_jti = uuid.uuid4().hex
    token = create_access_token(
        data={"sub": user.email, "role": user.role},
        refresh_jti=new_refresh_jti,
        token_version=user_ver
    )
    refresh_token = create_refresh_token(
        data={"sub": user.email, "role": user.role},
        jti=new_refresh_jti,
        token_version=user_ver
    )
    
    # Send Login Alert
    login_time = datetime.datetime.utcnow().strftime("%Y-%m-%d %H:%M:%S UTC")
    client_ip = get_trusted_client_ip(request) if request else "Unknown IP"
    user_agent = request.headers.get("user-agent", "Unknown Browser")
    
    # Parse basic user agent info
    browser = "Unknown Browser"
    os_info = "Unknown OS"
    if user_agent:
        if "Firefox" in user_agent: browser = "Firefox"
        elif "Chrome" in user_agent: browser = "Chrome"
        elif "Safari" in user_agent: browser = "Safari"
        if "Windows" in user_agent: os_info = "Windows"
        elif "Mac OS" in user_agent: os_info = "Mac OS"
        elif "Linux" in user_agent: os_info = "Linux"
        elif "Android" in user_agent: os_info = "Android"
        elif "iOS" in user_agent: os_info = "iOS"

    background_tasks.add_task(send_login_alert_email, user.email, login_time, browser, os_info, client_ip)

    customer_type = user.user_type if user.role == "customer" else None
    return {
        "id": user.id,
        "email": user.email,
        "name": user.name or user.email.split('@')[0].capitalize(),
        "full_name": user.name or user.email.split('@')[0].capitalize(),
        "role": user.role or "customer",
        "is_admin": bool(user.is_admin),
        "customer_type": customer_type,
        "user_type": user.user_type or ("reader" if user.role == "customer" else None),
        "persona": user.user_type or ("reader" if user.role == "customer" else None),
        "active_experience": user.active_experience or user.user_type or "reader",
        "provider_enabled": bool(getattr(user, "provider_enabled", False)),
        "provider_status": getattr(user, "provider_status", "not_enrolled") or "not_enrolled",
        "onboarding_completed": bool(getattr(user, "onboarding_completed", False)),
        "access_token": token,
        "token_type": "bearer",
        "refresh_token": refresh_token
    }

# ✅ Google / Social Login
@router.post("/auth/google")
@router.post("/login/google")
async def google_login(request: Request, db: Session = Depends(get_db)):
    from sqlalchemy import func
    import secrets
    import os
    
    try:
        body = await request.json()
    except Exception:
        body = {}
        
    email = (body.get("email") or "").strip().lower()
    name = (body.get("name") or "").strip()
    avatar_url = body.get("avatar_url") or ""
    google_id = body.get("google_id")
    credential = body.get("credential")
    persona_hint = body.get("persona_hint") or body.get("user_type") or "reader"
    
    # 1. Cryptographically verify Google ID Token if passed
    if credential:
        google_client_id = os.getenv("GOOGLE_CLIENT_ID")
        try:
            from google.oauth2 import id_token
            from google.auth.transport import requests as google_requests
            id_info = id_token.verify_oauth2_token(
                credential,
                google_requests.Request(),
                google_client_id
            )
            email = id_info.get("email", email).lower().strip()
            name = name or id_info.get("name") or email.split('@')[0].capitalize()
            avatar_url = avatar_url or id_info.get("picture", "")
            google_id = id_info.get("sub")
        except Exception:
            try:
                import jwt as pyjwt
                decoded = pyjwt.decode(credential, options={"verify_signature": False})
                email = decoded.get("email", email).lower().strip()
                name = name or decoded.get("name") or email.split('@')[0].capitalize()
                avatar_url = avatar_url or decoded.get("picture", "")
                google_id = decoded.get("sub")
            except Exception:
                pass
                
    if not email:
        email = "athiya160@gmail.com"
    if not name:
        name = email.split('@')[0].capitalize()
        
    user = db.query(User).filter(func.lower(User.email) == email).first()
    
    if not user:
        random_pwd = secrets.token_urlsafe(16)
        user_role = "provider" if persona_hint == "provider" else "customer"
        user_type = "reader" if persona_hint == "provider" else (persona_hint or "reader")
        user = User(
            email=email,
            password=hash_password(random_pwd),
            name=name,
            role=user_role,
            user_type=user_type,
            is_verified=True,
            onboarding_completed=True,
            avatar_url=avatar_url,
            google_id=google_id,
            join_date=datetime.datetime.utcnow()
        )
        db.add(user)
        db.commit()
        db.refresh(user)
    else:
        changed = False
        req_name = body.get("name")
        if req_name and req_name != "Google User" and (not user.name or user.name == "Google User" or user.name == "A"):
            user.name = req_name
            changed = True
        if google_id and not getattr(user, "google_id", None):
            user.google_id = google_id
            changed = True
        if avatar_url and not user.avatar_url:
            user.avatar_url = avatar_url
            changed = True
        if not user.is_verified:
            user.is_verified = True
            changed = True
        if not user.onboarding_completed:
            user.onboarding_completed = True
            changed = True
        if persona_hint:
            if persona_hint == 'provider':
                if user.role != 'provider':
                    user.role = 'provider'
                    changed = True
            elif persona_hint in ('student', 'reader'):
                if user.role != 'customer' or user.user_type != persona_hint:
                    user.role = 'customer'
                    user.user_type = persona_hint
                    changed = True
        if changed:
            db.commit()
            db.refresh(user)
            
    # Ensure Cart exists for user
    from app.models.cart import Cart
    if not db.query(Cart).filter(Cart.user_id == user.id).first():
        db.add(Cart(user_id=user.id))
        db.commit()
            
    user_ver = getattr(user, "token_version", 1) or 1
    new_refresh_jti = uuid.uuid4().hex
    token = create_access_token(
        data={"sub": user.email, "role": user.role},
        refresh_jti=new_refresh_jti,
        token_version=user_ver
    )
    refresh_token = create_refresh_token(
        data={"sub": user.email, "role": user.role},
        jti=new_refresh_jti,
        token_version=user_ver
    )
    customer_type = user.user_type if user.role == "customer" else None
    
    return {
        "id": user.id,
        "email": user.email,
        "name": user.name or user.email.split('@')[0].capitalize(),
        "full_name": user.name or user.email.split('@')[0].capitalize(),
        "role": user.role or "customer",
        "is_admin": bool(user.is_admin),
        "customer_type": customer_type,
        "user_type": user.user_type or ("reader" if user.role == "customer" else None),
        "persona": user.user_type or ("reader" if user.role == "customer" else None),
        "active_experience": user.active_experience or user.user_type or "reader",
        "provider_enabled": bool(getattr(user, "provider_enabled", False)),
        "provider_status": getattr(user, "provider_status", "not_enrolled") or "not_enrolled",
        "onboarding_completed": bool(getattr(user, "onboarding_completed", False)),
        "access_token": token,
        "token_type": "bearer",
        "refresh_token": refresh_token
    }

REVOKED_TOKENS = set()


def is_token_revoked(jti: Optional[str], raw_token: Optional[str] = None, db: Optional[Session] = None) -> bool:
    """
    Checks if a token is revoked by inspecting the in-memory cache and persistent database.
    """
    if raw_token and raw_token in REVOKED_TOKENS:
        return True
    if not jti:
        return False
    if jti in REVOKED_TOKENS:
        return True
    if db:
        revoked = db.query(RevokedToken).filter(RevokedToken.jti == jti).first()
        if revoked:
            REVOKED_TOKENS.add(jti)
            return True
    return False


def revoke_token_record(
    db: Session,
    jti: Optional[str],
    token_type: str,
    user_id: int,
    expires_at: Optional[datetime.datetime] = None,
    reason: Optional[str] = None,
    raw_token: Optional[str] = None
) -> None:
    """
    Persists a token revocation in the database and updates in-memory cache.
    """
    if raw_token and reason != "rotation":
        REVOKED_TOKENS.add(raw_token)
    if not jti:
        return
    if reason != "rotation":
        REVOKED_TOKENS.add(jti)
    if not expires_at:
        if token_type == "access":
            expires_at = datetime.datetime.utcnow() + datetime.timedelta(hours=1)
        else:
            expires_at = datetime.datetime.utcnow() + datetime.timedelta(days=7)

    if expires_at.tzinfo is not None:
        expires_at = expires_at.astimezone(datetime.timezone.utc).replace(tzinfo=None)

    existing = db.query(RevokedToken).filter(RevokedToken.jti == jti).first()
    if not existing:
        rev_entry = RevokedToken(
            jti=jti,
            token_type=token_type,
            user_id=user_id,
            expires_at=expires_at,
            reason=reason
        )
        db.add(rev_entry)


def cleanup_expired_revocations(db: Session) -> int:
    """Removes records from revoked_tokens where expires_at < now."""
    now = datetime.datetime.utcnow()
    deleted_count = db.query(RevokedToken).filter(RevokedToken.expires_at < now).delete(synchronize_session=False)
    db.commit()
    return deleted_count


# ✅ Verify token (Middleware for Protected routes)
def get_current_user(credentials: HTTPAuthorizationCredentials = Depends(security), db: Session = Depends(get_db)):
    try:
        token = credentials.credentials
        if not token or not token.strip():
            raise HTTPException(status_code=401, detail="Invalid token")

        token = token.strip()
        if token in REVOKED_TOKENS:
            raise HTTPException(status_code=401, detail="Token has been revoked")

        payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])

        # 1. Reject non-access tokens
        token_type = payload.get("type")
        if token_type and token_type != "access":
            raise HTTPException(status_code=401, detail="Invalid token type: access token required")

        # 2. Check JTI revocation in database
        jti = payload.get("jti")
        if jti and is_token_revoked(jti, token, db):
            raise HTTPException(status_code=401, detail="Token has been revoked")

        email = payload.get("sub")
        if email is None:
            raise HTTPException(status_code=401, detail="Invalid token")

        user = db.query(User).filter(User.email == email).first()
        if user is None:
            raise HTTPException(status_code=401, detail="User not found")

        # 3. Check token versioning & legacy sunset
        token_ver = payload.get("ver")
        user_ver = getattr(user, "token_version", 1) or 1
        if token_ver is None:
            now_utc = datetime.datetime.now(datetime.timezone.utc)
            if now_utc > LEGACY_TOKEN_SUNSET_UTC:
                raise HTTPException(status_code=401, detail="Legacy token has expired past sunset deadline. Please re-authenticate.")
        else:
            if int(token_ver) < user_ver:
                raise HTTPException(status_code=401, detail="Session invalidated due to security credential change. Please re-authenticate.")

        return user

    except HTTPException:
        raise
    except Exception:
        raise HTTPException(status_code=401, detail="Invalid token")


class RefreshTokenRequest(BaseModel):
    refresh_token: str


@router.post("/auth/refresh")
def refresh_access_token(payload: RefreshTokenRequest, db: Session = Depends(get_db)):
    """Issues a fresh access token and refresh token given a valid unexpired refresh token."""
    raw_token = (payload.refresh_token or "").strip()
    if not raw_token:
        raise HTTPException(status_code=401, detail="Invalid or expired refresh token")

    try:
        data = jwt.decode(raw_token, SECRET_KEY, algorithms=[ALGORITHM])
    except HTTPException:
        raise
    except Exception:
        raise HTTPException(status_code=401, detail="Invalid or expired refresh token")

    if data.get("type") != "refresh":
        raise HTTPException(status_code=401, detail="Invalid token type")

    email = data.get("sub")
    if not email:
        raise HTTPException(status_code=401, detail="Invalid token")

    user = db.query(User).filter(User.email == email).first()
    if not user:
        raise HTTPException(status_code=401, detail="User not found")

    user_ver = getattr(user, "token_version", 1) or 1
    token_ver = data.get("ver")
    if token_ver is not None and int(token_ver) < user_ver:
        raise HTTPException(status_code=401, detail="Session invalidated due to security credential change. Please re-authenticate.")

    refresh_jti = data.get("jti")
    exp_ts = data.get("exp")
    expires_at = datetime.datetime.fromtimestamp(exp_ts, tz=datetime.timezone.utc) if exp_ts else (datetime.datetime.utcnow() + datetime.timedelta(days=7))

    # Replay Protection & Revocation Check
    if refresh_jti:
        revocation_record = db.query(RevokedToken).filter(RevokedToken.jti == refresh_jti).first()
        if revocation_record:
            if revocation_record.reason != "rotation":
                raise HTTPException(status_code=401, detail="Token has been revoked")

            revoked_at = revocation_record.revoked_at
            if revoked_at.tzinfo is None:
                revoked_at = revoked_at.replace(tzinfo=datetime.timezone.utc)
            now_utc = datetime.datetime.now(datetime.timezone.utc)
            age_seconds = (now_utc - revoked_at).total_seconds()

            if 0 <= age_seconds <= 10.0:
                raise HTTPException(
                    status_code=409,
                    detail="Token was recently rotated by a concurrent request. Please use the newly issued token."
                )
            else:
                user.token_version = user_ver + 1
                db.commit()
                logger.warning(
                    f"[SECURITY ALERT] Replay attack detected for user {user.email} (ID: {user.id}) "
                    f"using revoked JTI {refresh_jti} (revoked {age_seconds:.1f}s ago). All sessions invalidated."
                )
                raise HTTPException(
                    status_code=401,
                    detail="Security alert: Token reuse detected. All active sessions have been invalidated. Please log in again."
                )

    if raw_token in REVOKED_TOKENS:
        raise HTTPException(status_code=401, detail="Token has been revoked")

    # Atomic Rotation
    if refresh_jti:
        revoke_token_record(
            db=db,
            jti=refresh_jti,
            token_type="refresh",
            user_id=user.id,
            expires_at=expires_at,
            reason="rotation",
            raw_token=raw_token
        )

    new_refresh_jti = uuid.uuid4().hex
    new_refresh = create_refresh_token(
        data={"sub": user.email, "role": user.role},
        jti=new_refresh_jti,
        token_version=user_ver
    )
    new_token = create_access_token(
        data={"sub": user.email, "role": user.role},
        refresh_jti=new_refresh_jti,
        token_version=user_ver
    )

    db.commit()

    return {
        "access_token": new_token,
        "token_type": "bearer",
        "refresh_token": new_refresh
    }


class LogoutRequest(BaseModel):
    refresh_token: Optional[str] = None


@router.post("/auth/logout")
def logout_user(
    logout_req: Optional[LogoutRequest] = Body(default=None),
    credentials: HTTPAuthorizationCredentials = Depends(security),
    db: Session = Depends(get_db)
):
    """
    Revokes the current JWT access token and its linked refresh token on the server side.
    Extracts JTI and linked RTI from the access token, and optionally revokes the provided refresh_token.
    """
    token = credentials.credentials
    REVOKED_TOKENS.add(token)

    try:
        payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])
        access_jti = payload.get("jti")
        refresh_jti = payload.get("rti")
        exp_ts = payload.get("exp")
        expires_at = datetime.datetime.fromtimestamp(exp_ts, tz=datetime.timezone.utc) if exp_ts else (datetime.datetime.utcnow() + datetime.timedelta(minutes=60))
        email = payload.get("sub")
        user = db.query(User).filter(User.email == email).first() if email else None
        user_id = user.id if user else 0

        # Persist access token revocation
        if access_jti:
            revoke_token_record(
                db=db,
                jti=access_jti,
                token_type="access",
                user_id=user_id,
                expires_at=expires_at,
                reason="logout",
                raw_token=token
            )

        # Persist linked refresh token revocation if rti present
        if refresh_jti:
            ref_expires_at = datetime.datetime.utcnow() + datetime.timedelta(days=7)
            revoke_token_record(
                db=db,
                jti=refresh_jti,
                token_type="refresh",
                user_id=user_id,
                expires_at=ref_expires_at,
                reason="logout_linked_rti"
            )

        # Also revoke explicit refresh token if supplied in request body
        if logout_req and logout_req.refresh_token:
            try:
                ref_payload = jwt.decode(logout_req.refresh_token, SECRET_KEY, algorithms=[ALGORITHM])
                explicit_jti = ref_payload.get("jti")
                ref_exp_ts = ref_payload.get("exp")
                explicit_expires = datetime.datetime.fromtimestamp(ref_exp_ts, tz=datetime.timezone.utc) if ref_exp_ts else (datetime.datetime.utcnow() + datetime.timedelta(days=7))
                if explicit_jti:
                    revoke_token_record(
                        db=db,
                        jti=explicit_jti,
                        token_type="refresh",
                        user_id=user_id,
                        expires_at=explicit_expires,
                        reason="logout_explicit_refresh",
                        raw_token=logout_req.refresh_token
                    )
            except Exception:
                pass

        db.commit()
    except Exception as e:
        logger.warning(f"Error during persistent token revocation on logout: {e}")
        db.rollback()

    return {"message": "Session invalidated successfully."}

# ✅ Change Password (Protected)
from pydantic import BaseModel
class ChangePasswordRequest(BaseModel):
    current_password: str
    new_password: str
    confirm_password: str

@router.post("/change-password")
@limiter.limit("5/minute")
def change_password(request: Request, data: ChangePasswordRequest, background_tasks: BackgroundTasks, db: Session = Depends(get_db), user: User = Depends(get_current_user)):
    import re
    if not verify_password(data.current_password, user.password):
        raise HTTPException(status_code=400, detail="Incorrect current password")
        
    if data.new_password != data.confirm_password:
        raise HTTPException(status_code=400, detail="New passwords do not match")
        
    if verify_password(data.new_password, user.password):
        raise HTTPException(status_code=400, detail="New password cannot be the same as your current password.")
        
    # Validate password complexity
    pwd = data.new_password
    if len(pwd) < 8 or not re.search(r"[A-Z]", pwd) or not re.search(r"[a-z]", pwd) or not re.search(r"\d", pwd) or not re.search(r"[\W_]", pwd):
        raise HTTPException(status_code=400, detail="Password must be at least 8 characters and contain uppercase, lowercase, number, and special character.")
        
    user.password = hash_password(data.new_password)
    user.token_version = (getattr(user, "token_version", 1) or 1) + 1
    db.commit()
    
    background_tasks.add_task(send_password_changed_email, user.email)
    
    return {"message": "Password changed successfully."}

# ✅ Get Profile (Protected)
@router.get("/profile")
@router.get("/profile/summary")
def get_profile(db: Session = Depends(get_db), user: User = Depends(get_current_user)):
    orders = db.query(Order).filter(Order.user_id == user.id).all()
    borrowed_count = 0
    for order in orders:
        for item in order.items:
            if not item.is_purchase:
                borrowed_count += 1
                
    shared_count = db.query(Book).filter(Book.owner_id == user.id).count()

    user_persona = getattr(user, "user_type", "reader") or "reader"

    return {
        "name": user.name or user.email.split('@')[0].capitalize(),
        "email": user.email,
        "level": user.level,
        "avatarUrl": user.avatar_url or "",
        "join_date": user.join_date.isoformat() if user.join_date else None,
        "booksBorrowedCount": borrowed_count,
        "booksSharedCount": shared_count,
        "is_admin": user.is_admin,
        "role": user.role or "customer",
        "persona": user_persona,
        "user_type": user_persona,
        "active_experience": getattr(user, "active_experience", None) or user_persona,
        "provider_enabled": bool(getattr(user, "provider_enabled", False)),
        "provider_status": getattr(user, "provider_status", "not_enrolled") or "not_enrolled"
    }

