# Dynamic Frontend URL Registry for local development
DYNAMIC_FRONTEND_URL = None

def get_frontend_url(request: Request = None) -> str:
    global DYNAMIC_FRONTEND_URL
    import os
    import re

    env_url = os.environ.get("FRONTEND_URL")
    if env_url:
        return env_url.rstrip("/")

    if request:
        custom_header = request.headers.get("x-frontend-url")
        origin = request.headers.get("origin")
        candidate = custom_header or origin
        if candidate and (candidate.startswith("http://") or candidate.startswith("https://")):
            # If candidate uses an ephemeral debug port (like 50000+), sanitize it to 8080
            match = re.search(r':(\d+)$', candidate)
            if match and int(match.group(1)) > 10000 and int(match.group(1)) != 8080:
                candidate = re.sub(r':\d+$', ':8080', candidate)
            DYNAMIC_FRONTEND_URL = candidate.rstrip("/")
    
    if DYNAMIC_FRONTEND_URL:
        match = re.search(r':(\d+)$', DYNAMIC_FRONTEND_URL)
        if match and int(match.group(1)) > 10000 and int(match.group(1)) != 8080:
            DYNAMIC_FRONTEND_URL = re.sub(r':\d+$', ':8080', DYNAMIC_FRONTEND_URL)
        return DYNAMIC_FRONTEND_URL

    if request:
        host = request.headers.get("host", "localhost:8000")
        hostname = host.split(":")[0]
        return f"http://{hostname}:8080"

    return "http://localhost:8080"

def generate_reset_link(request: Request, raw_token: str) -> str:
    frontend_url = get_frontend_url(request)
    return f"{frontend_url}/reset-password?token={raw_token}"

pwd_context = CryptContext(schemes=["bcrypt"], deprecated="auto")
security = HTTPBearer()

router = APIRouter()

# Password utils
def hash_password(password: str):
    return pwd_context.hash(password)

def verify_password(plain, hashed):
    return pwd_context.verify(plain, hashed)

# DB connection
def get_db():
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()

# ✅ Register
@router.post("/register")
@limiter.limit("5/minute")
def register(request: Request, user: UserCreate, background_tasks: BackgroundTasks, db: Session = Depends(get_db)):
    from sqlalchemy import func
    cleaned_email = (user.email or "").strip().lower()
    existing_user = db.query(User).filter(func.lower(User.email) == cleaned_email).first()
    if existing_user:
        raise HTTPException(status_code=400, detail="Email already registered")

    role = (user.role or "customer").lower()
    if role not in ["customer", "provider"]:
        role = "customer"

    if role == "customer":
        selected_persona = user.customer_type or user.persona or user.user_type or "reader"
        if hasattr(selected_persona, "value"):
            selected_persona = selected_persona.value
        if selected_persona not in ["student", "reader"]:
            selected_persona = "reader"
    else:
        selected_persona = None

    active_exp = getattr(user, "active_experience", None) or selected_persona or "reader"
    is_prov = (role == "provider")

    new_user = User(
        email=cleaned_email,
        password=hash_password(user.password),
        name=user.name,
        phone=user.phone.strip() if getattr(user, "phone", None) else None,
        role=role,
        user_type=selected_persona,
        active_experience=active_exp,
        provider_enabled=is_prov,
        provider_status="active" if is_prov else "not_enrolled",
        onboarding_completed=False,
        is_verified=False
    )

    db.add(new_user)
    try:
        db.commit()
        db.refresh(new_user)
    except IntegrityError:
        db.rollback()
        raise HTTPException(status_code=400, detail="Email already registered")

    # If student provided optional academic details during signup, create StudentProfile
    if selected_persona == "student":
        from app.models.student_profile import StudentProfile
        has_academic_info = bool(user.course or user.college or user.semester)
        academic_interests = []
        if user.college:
            academic_interests.append(f"College: {user.college}")
        if user.semester:
            academic_interests.append(f"Semester: {user.semester}")
        if user.graduation_year:
            academic_interests.append(f"Graduation: {user.graduation_year}")

        sp = StudentProfile(
            user_id=new_user.id,
            course=user.course,
            college=user.college,
            semester=user.semester,
            graduation_year=user.graduation_year,
            syllabus_details=user.syllabus,
            education_level=user.semester or "Undergraduate",
            exam_goal=user.semester or "Semester Exams",
            academic_interests=json.dumps(academic_interests)
        )
        db.add(sp)
        if has_academic_info:
            new_user.onboarding_completed = True
        db.commit()

    # Welcome Email and Verification Email
    base_url = str(request.base_url).rstrip("/")
    token = create_verification_token(new_user.email)
    verify_link = f"{base_url}/verify-email?token={token}"
    
    # Send asynchronously so it doesn't block registration if it fails
    background_tasks.add_task(send_welcome_email, new_user.email, new_user.name or "Reader")
    background_tasks.add_task(send_verification_email, new_user.email, verify_link)

    user_ver = getattr(new_user, "token_version", 1) or 1
    new_refresh_jti = uuid.uuid4().hex
    refresh_token = create_refresh_token(
        data={"sub": new_user.email, "role": new_user.role},
        jti=new_refresh_jti,
        token_version=user_ver
    )
    access_token = create_access_token(
        data={"sub": new_user.email, "role": new_user.role},
        refresh_jti=new_refresh_jti,
        token_version=user_ver
    )

    customer_type = new_user.user_type if new_user.role == "customer" else None
    return {
        "message": "User registered successfully. Please check your email to verify your account.",
        "access_token": access_token,
        "token_type": "bearer",
        "refresh_token": refresh_token,
        "role": new_user.role,
        "customer_type": customer_type,
        "persona": new_user.user_type or ("reader" if new_user.role == "customer" else None),
        "user_type": new_user.user_type or ("reader" if new_user.role == "customer" else None),
        "active_experience": new_user.active_experience or selected_persona or "reader",
        "provider_enabled": bool(getattr(new_user, "provider_enabled", False)),
        "provider_status": getattr(new_user, "provider_status", "not_enrolled") or ("active" if is_prov else "not_enrolled"),
        "onboarding_completed": bool(new_user.onboarding_completed)
    }

# ✅ Verify Email endpoint
@router.get("/verify-email")
@limiter.limit("10/minute")
def verify_email(request: Request, token: str, db: Session = Depends(get_db)):
    from sqlalchemy import func
    email = verify_verification_token(token)
    if not email:
        html = render_template("message.html", title="Verification Expired", heading="Link Expired or Invalid", message="This verification link is invalid or has expired. Please request a new one.", is_success=False)
        return HTMLResponse(content=html, status_code=400)
        
    user = db.query(User).filter(func.lower(User.email) == email.lower()).first()
    if not user:
        html = render_template("message.html", title="Verification Failed", heading="User Not Found", message="Could not find the user associated with this verification link.", is_success=False)
        return HTMLResponse(content=html, status_code=404)
        
    if user.is_verified:
        html = render_template("message.html", title="Already Verified", heading="Already Verified", message="Your email address is already verified.", is_success=True, show_login=True)
        return HTMLResponse(content=html)

    user.is_verified = True
    db.commit()
    
    html = render_template("message.html", title="Verification Successful", heading="Email Verified Successfully!", message="Your account is now fully verified and active. Welcome to The Tactile Archive!", is_success=True, show_login=True)
    return HTMLResponse(content=html)

