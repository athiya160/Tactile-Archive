            color: var(--text-muted);
            font-size: 14px;
            margin-bottom: 24px;
        }
        .danger-card {
            background-color: var(--danger-bg);
            border: 1px solid #FCA5A5;
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 24px;
        }
        .danger-title {
            color: var(--danger);
            font-weight: 700;
            font-size: 15px;
            margin-bottom: 8px;
        }
        .section-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--primary);
            margin-top: 24px;
            margin-bottom: 12px;
            border-bottom: 1px solid var(--border);
